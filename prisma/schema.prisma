// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  owner
  admin
  staff
}

enum OrgMemberStatus {
  active
  invited
  removed
}

enum TradeRole {
  electrician
  apprentice
  office
}

enum LocationType {
  van
  warehouse
  store
  site
}

enum PricingItemType {
  fixed
  addon
}

enum QuoteStatus {
  pending
  draft
  sent
  accepted
  declined
}

enum JobStatus {
  pending
  in_progress
  completed
  cancelled
}

enum QuoteItemType {
  fixed
  addon
  labour
  adjustment
}

enum SWILibraryType {
  ppe
  tool
  test
  part
  hazard
  step
  definition
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  phone        String?
  passwordHash String?
  createdAt    DateTime     @default(now())

  accounts     Account[]
  sessions     Session[]
  orgMembers   OrgMember[]
  auditLogs    AuditLog[]
  stockMoves   StockMovement[]
}

model Org {
  id             String       @id @default(cuid())
  name           String
  abn            String?
  defaultGstRate Decimal      @default(0.10) @db.Decimal(4, 2)
  logoUrl        String?
  createdAt      DateTime     @default(now())

  members        OrgMember[]
  invites        Invite[]
  locations      Location[]
  sessions       Session[]
  auditLogs      AuditLog[]
  vendors        Vendor[]
  items          Item[]
  stockItems     StockItem[]
  stockMoves     StockMovement[]
  receipts       Receipt[]
  pricingProfiles PricingProfile[]
  customers      Customer[]
  quotes         Quote[]
  quoteTemplates QuoteTemplate[]
  quoteHistories QuoteHistory[]
  jobs           Job[]
  jobTasks       JobTask[]
  jobSwis        JobSWI[]
  services       Service[]
  serviceSwis    ServiceSWI[]
  swiLibraryItems SWILibraryItem[]
}

model OrgMember {
  id        String          @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole         @default(owner)
  status    OrgMemberStatus @default(active)
  tradeRole TradeRole       @default(office)
  createdAt DateTime        @default(now())

  org           Org     @relation(fields: [orgId], references: [id])
  user          User    @relation(fields: [userId], references: [id])
  assignedQuotes Quote[] @relation("QuoteAssignee")
  assignedJobs   Job[]   @relation("JobAssignee")
  completedTasks JobTask[] @relation("TaskCompleter")
  quoteHistoryUpdates QuoteHistory[] @relation("QuoteHistoryUpdater")

  @@unique([orgId, userId])
  @@index([userId])
}

model Invite {
  id         String   @id @default(cuid())
  orgId      String
  email      String
  role       OrgRole  @default(staff)
  token      String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([email])
}

model Location {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  type      LocationType @default(van)
  createdAt DateTime     @default(now())

  org Org @relation(fields: [orgId], references: [id])

  stockItems StockItem[]
  stockMoves StockMovement[]

  @@index([orgId])
}

model Vendor {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())

  org   Org     @relation(fields: [orgId], references: [id])
  items Item[]

  @@index([orgId])
  @@unique([orgId, name])
}

model Item {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  sku           String?
  barcode       String?
  vendorId      String?
  unitCost      Decimal? @db.Decimal(10, 2)
  sellPrice     Decimal? @db.Decimal(10, 2)
  taxRate       Decimal? @db.Decimal(4, 2)
  source        String   @default("manual")
  sourceRef     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org    Org     @relation(fields: [orgId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id])
  stock  StockItem[]
  receipts ReceiptItem[]
  stockMoves StockMovement[]

  @@index([orgId])
  @@index([vendorId])
  @@unique([orgId, sku])
}

model StockItem {
  id         String   @id @default(cuid())
  orgId      String
  itemId     String
  locationId String
  onHand     Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt

  org      Org      @relation(fields: [orgId], references: [id])
  item     Item     @relation(fields: [itemId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@index([orgId])
  @@unique([itemId, locationId])
}

model StockMovement {
  id          String   @id @default(cuid())
  orgId       String
  itemId      String
  locationId  String
  quantity    Decimal  @db.Decimal(12, 2)
  reason      String
  receiptId   String?
  createdById String?
  createdAt   DateTime @default(now())

  org      Org       @relation(fields: [orgId], references: [id])
  item     Item      @relation(fields: [itemId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  receipt  Receipt?  @relation(fields: [receiptId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([orgId])
  @@index([itemId])
  @@index([locationId])
}

model Receipt {
  id          String   @id @default(cuid())
  orgId       String
  vendorName  String?
  receiptDate DateTime?
  total       Decimal? @db.Decimal(12, 2)
  tax         Decimal? @db.Decimal(12, 2)
  rawText     String?
  status      String   @default("parsed")
  createdAt   DateTime @default(now())

  org   Org           @relation(fields: [orgId], references: [id])
  items ReceiptItem[]
  stockMoves StockMovement[]

  @@index([orgId])
}

model ReceiptItem {
  id        String   @id @default(cuid())
  receiptId String
  itemId    String?
  name      String
  quantity  Decimal? @db.Decimal(12, 2)
  unitPrice Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id])
  item    Item?   @relation(fields: [itemId], references: [id])
}

model PricingProfile {
  id                    String   @id @default(cuid())
  orgId                 String
  name                  String
  region                String?
  serviceAreaKm         Int?      @default(20)
  travelSurchargeEnabled Boolean  @default(false)
  travelSurchargeAmount Decimal?  @db.Decimal(10, 2)
  minimumCharge         Decimal   @db.Decimal(10, 2)
  calloutFirstHour      Decimal   @db.Decimal(10, 2)
  hourlyRate            Decimal   @db.Decimal(10, 2)
  intervalMinutes       Int       @default(15)
  intervalRate          Decimal   @db.Decimal(10, 2)
  afterHoursMultiplier  Decimal   @default(1.5) @db.Decimal(4, 2)
  gstRate               Decimal   @default(0.10) @db.Decimal(4, 2)
  pricesIncludeGst      Boolean   @default(true)
  complianceText        String?
  comparisonText        String?
  customerSummary       String?
  customerExplanation   String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org        Org             @relation(fields: [orgId], references: [id])
  categories PricingCategory[]

  @@index([orgId])
}

model PricingCategory {
  id         String   @id @default(cuid())
  profileId  String
  name       String
  sortOrder  Int      @default(0)

  profile PricingProfile @relation(fields: [profileId], references: [id])
  items   PricingItem[]
}

model PricingItem {
  id          String           @id @default(cuid())
  categoryId  String
  type        PricingItemType
  name        String
  description String?
  price       Decimal          @db.Decimal(10, 2)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)

  category PricingCategory @relation(fields: [categoryId], references: [id])
  quoteItems QuoteItem[]
}

model Customer {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  email     String?
  phone     String?
  siteLine1 String?
  siteLine2 String?
  siteSuburb String?
  siteState String?
  sitePostcode String?
  createdAt DateTime @default(now())

  org    Org     @relation(fields: [orgId], references: [id])
  quotes Quote[]
  jobs   Job[]

  @@index([orgId])
}

model Job {
  id                     String    @id @default(cuid())
  orgId                  String
  customerId             String
  assignedToMemberId     String?
  status                 JobStatus @default(pending)
  title                  String?
  customerName           String
  customerEmail          String?
  customerPhone          String?
  siteLine1              String
  siteLine2              String?
  siteSuburb             String?
  siteState              String?
  sitePostcode           String?
  notes                  String?
  scheduledStart         DateTime?
  scheduledEnd           DateTime?
  scheduledAllDay        Boolean   @default(false)
  scheduledNotes         String?
  travelSurchargeApplied Boolean   @default(false)
  travelSurchargeAmount  Decimal?  @db.Decimal(10, 2)
  minimumChargeApplied   Boolean   @default(false)
  minimumChargeAmount    Decimal?  @db.Decimal(10, 2)
  subtotal               Decimal?  @db.Decimal(12, 2)
  gstAmount              Decimal?  @db.Decimal(12, 2)
  total                  Decimal?  @db.Decimal(12, 2)
  quotePdfUrl            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  org      Org      @relation(fields: [orgId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  assignedToMember OrgMember? @relation("JobAssignee", fields: [assignedToMemberId], references: [id])
  quotes   Quote[]
  tasks    JobTask[]
  swi      JobSWI?

  @@index([orgId])
  @@index([customerId])
  @@index([assignedToMemberId])
}

model JobSWI {
  id        String   @id @default(cuid())
  orgId     String
  jobId     String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id])
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([jobId])
}

model Service {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  price     Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id])
  swi ServiceSWI?

  @@index([orgId])
  @@unique([orgId, name])
}

model ServiceSWI {
  id        String   @id @default(cuid())
  orgId     String
  serviceId String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Org     @relation(fields: [orgId], references: [id])
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([serviceId])
}

model SWILibraryItem {
  id        String         @id @default(cuid())
  orgId     String
  type      SWILibraryType
  name      String
  usage     String?
  howTo     String?
  photoUrls Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  org Org @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([type])
}

model JobTask {
  id                  String   @id @default(cuid())
  orgId               String
  jobId               String
  sourceQuoteId       String?
  name                String
  description         String?
  sortOrder           Int      @default(0)
  status              String   @default("pending")
  completedAt         DateTime?
  completedByMemberId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org      Org      @relation(fields: [orgId], references: [id])
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceQuote Quote? @relation(fields: [sourceQuoteId], references: [id])
  completedBy OrgMember? @relation("TaskCompleter", fields: [completedByMemberId], references: [id])

  @@index([orgId])
  @@index([jobId])
  @@index([sourceQuoteId])
  @@index([completedByMemberId])
}

model Quote {
  id                  String      @id @default(cuid())
  orgId               String
  customerId          String?
  jobId               String?
  status              QuoteStatus @default(draft)
  assignedToMemberId  String?
  sentAt              DateTime?
  sentVia             QuoteSentVia?
  title               String?
  customerName        String
  customerEmail       String?
  customerPhone       String?
  siteLine1           String
  siteLine2           String?
  siteSuburb          String?
  siteState           String?
  sitePostcode        String?
  pricingProfileId    String?
  travelSurchargeApplied Boolean   @default(false)
  travelSurchargeAmount  Decimal?  @db.Decimal(10, 2)
  minimumChargeApplied   Boolean   @default(false)
  minimumChargeAmount    Decimal?  @db.Decimal(10, 2)
  subtotal            Decimal     @db.Decimal(12, 2)
  gstAmount           Decimal     @db.Decimal(12, 2)
  total               Decimal     @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  org      Org       @relation(fields: [orgId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  job      Job?      @relation(fields: [jobId], references: [id])
  assignedToMember OrgMember? @relation("QuoteAssignee", fields: [assignedToMemberId], references: [id])
  jobTasks         JobTask[]
  items    QuoteItem[]
  history  QuoteHistory[]

  @@index([orgId])
  @@index([customerId])
  @@index([jobId])
  @@index([assignedToMemberId])
}

model QuoteItem {
  id            String       @id @default(cuid())
  quoteId       String
  pricingItemId String?
  serviceId     String?
  type          QuoteItemType
  name          String
  description   String?
  quantity      Decimal      @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal      @db.Decimal(10, 2)
  lineTotal     Decimal      @db.Decimal(12, 2)

  quote       Quote        @relation(fields: [quoteId], references: [id])
  service     Service?     @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
}

model QuoteTemplate {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  isDefault Boolean  @default(false)
  blocks    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model QuoteHistory {
  id                     String      @id @default(cuid())
  orgId                  String
  quoteId                String
  status                 QuoteStatus @default(draft)
  title                  String?
  customerName           String
  customerEmail          String?
  customerPhone          String?
  siteLine1              String
  siteLine2              String?
  siteSuburb             String?
  siteState              String?
  sitePostcode           String?
  pricingProfileId       String?
  travelSurchargeApplied Boolean   @default(false)
  travelSurchargeAmount  Decimal?  @db.Decimal(10, 2)
  minimumChargeApplied   Boolean   @default(false)
  minimumChargeAmount    Decimal?  @db.Decimal(10, 2)
  subtotal               Decimal   @db.Decimal(12, 2)
  gstAmount              Decimal   @db.Decimal(12, 2)
  total                  Decimal   @db.Decimal(12, 2)
  notes                  String?
  jobId                  String?
  customerId             String?
  assignedToMemberId     String?
  changedByMemberId      String?
  createdAt              DateTime  @default(now())

  org   Org   @relation(fields: [orgId], references: [id])
  quote Quote @relation(fields: [quoteId], references: [id])
  changedByMember OrgMember? @relation("QuoteHistoryUpdater", fields: [changedByMemberId], references: [id])
  items QuoteHistoryItem[]

  @@index([orgId])
  @@index([quoteId])
  @@index([createdAt])
  @@index([changedByMemberId])
}

model QuoteHistoryItem {
  id            String       @id @default(cuid())
  historyId     String
  pricingItemId String?
  type          QuoteItemType
  name          String
  description   String?
  quantity      Decimal      @db.Decimal(10, 2)
  unitPrice     Decimal      @db.Decimal(10, 2)
  lineTotal     Decimal      @db.Decimal(12, 2)

  history QuoteHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@index([historyId])
}

enum QuoteSentVia {
  email
  sms
}

model AuditLog {
  id           String   @id @default(cuid())
  orgId        String
  userId       String
  action       String
  entityType   String
  entityId     String
  metadataJson Json?
  createdAt    DateTime @default(now())

  org  Org  @relation(fields: [orgId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  orgId        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org? @relation(fields: [orgId], references: [id])

  @@index([userId])
  @@index([orgId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
